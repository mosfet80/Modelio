<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>doc-modules</artifactId>
	<packaging>pom</packaging>

	<parent>
		<groupId>org.modelio</groupId>
		<artifactId>doc-parent</artifactId>
		<version>6.2.0-SNAPSHOT</version>
		<relativePath>../../parent</relativePath>
	</parent>

	<properties>
		<outputDirectory>target/plugins</outputDirectory>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.modelio.module</groupId>
			<artifactId>documentpublisher-doc</artifactId>
			<version>[4.17.0,4.18.0)</version>
		</dependency>
		<dependency>
			<groupId>com.modelio.module</groupId>
			<artifactId>excelexchange-doc</artifactId>
			<version>[3.8.0,3.9.0)</version>
		</dependency>
		<dependency>
			<groupId>com.modelio.module</groupId>
			<artifactId>javaarchitect-doc</artifactId>
			<version>[1.7.0,1.8.0)</version>
		</dependency>
		<dependency>
			<groupId>com.modeliosoft.modules</groupId>
			<artifactId>javaunit-doc</artifactId>
			<version>[3.18.0,3.19.0)</version>
		</dependency>
		<dependency>
			<groupId>com.modeliosoft.modelio.module</groupId>
			<artifactId>modeliostudio-doc</artifactId>
			<version>[2.3.0,2.4.0)</version>
		</dependency>
		<dependency>
			<groupId>com.modelio.module</groupId>
			<artifactId>sqldesigner-doc</artifactId>
			<version>[4.17.0,4.18.0)</version>
		</dependency>
		<dependency>
			<groupId>com.modelio.module</groupId>
			<artifactId>sysmlarchitect-doc</artifactId>
			<version>[3.13.00,3.14.00)</version>
		</dependency>
		<dependency>
			<groupId>com.modelio.module</groupId>
			<artifactId>templateeditor-doc</artifactId>
			<version>[4.17.0,4.18.0)</version>
		</dependency>
		<dependency>
			<groupId>com.modelio.module</groupId>
			<artifactId>togafarchitect-doc</artifactId>
			<version>[4.10.0,4.11.0)</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>${tycho-groupid}</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho-version}</version>
				<extensions>true</extensions>
				<configuration>
					<resolver>p2</resolver>
				</configuration>
			</plugin>
			<plugin>
				<groupId>${tycho-groupid}</groupId>
				<artifactId>tycho-packaging-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<strictVersions>false</strictVersions>
					<archive>
						<!-- don't create the maven directory (descriptor files) in META-INF -->
						<addMavenDescriptor>false</addMavenDescriptor>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>2.8</version>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>initialize</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<description>Defines the list of documentation plugins to aggregate for the Modelio Web Site.</description>
</project>
