<assembly
	xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
	<id>modelioHelp</id>
	<formats>
		<format>war</format>
	</formats>
	<includeBaseDirectory>false</includeBaseDirectory>

	<fileSets>

		<!--  Eclipse Information Center  -->
		<fileSet>
			<directory>${infocenter.tmp}</directory>
			<outputDirectory>.</outputDirectory>
			<includes>
				<include>**/*</include>
			</includes>
		</fileSet>

		<!--  Modelio documentation -->
		<fileSet>
			<directory>${modeliohelp.doc.plugins}</directory>
			<outputDirectory>./WEB-INF/eclipse/plugins/</outputDirectory>
			<includes>
				<include>*.jar</include>
			</includes>
		</fileSet>

	<!--  Modules documentations  -->
		<fileSet>
			<directory>${moduleshelp.doc.plugins}</directory>
			<outputDirectory>./WEB-INF/eclipse/plugins/</outputDirectory>
			<includes>
				<include>*.jar</include>
			</includes>
		</fileSet>

	</fileSets>

</assembly>
