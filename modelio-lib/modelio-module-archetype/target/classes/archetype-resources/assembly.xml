#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\' )
<assembly
	xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.${version}"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.${version} http://maven.apache.org/xsd/assembly-1.${version}.xsd">
	<id>bin</id>
	<formats>
		<format>zip</format>
	</formats>
	<includeBaseDirectory>false</includeBaseDirectory>
	<fileSets>
		<!-- Copy XML resources -->
		<fileSet>
			<directory>${symbol_dollar}{project.basedir}/src/main/conf</directory>
			<outputDirectory>/${symbol_dollar}{project.name}</outputDirectory>
			<includes>
				<include>**/*.xml</include>
			</includes>
			<filtered>true</filtered>
		</fileSet>
		<!-- Copy other ressources -->
		<fileSet>
			<directory>${symbol_dollar}{project.basedir}/src/main/conf</directory>
			<outputDirectory>/${symbol_dollar}{project.name}</outputDirectory>
			<excludes>
				<exclude>**/*.xml</exclude>
			</excludes>
			<filtered>false</filtered>
		</fileSet>
		<!-- Copy module's jar file -->
		<fileSet>
			<directory>${symbol_dollar}{project.build.directory}</directory>
			<outputDirectory>${symbol_dollar}{project.name}/lib</outputDirectory>
			<includes>
				<include>${symbol_dollar}{project.artifactId}-${symbol_dollar}{project.version}.jar</include>
			</includes>
		</fileSet>
		<!-- Copy java dependencies needed by the module -->
		<fileSet>
			<directory>${symbol_dollar}{project.build.directory}/lib</directory>
			<outputDirectory>${symbol_dollar}{project.name}/lib</outputDirectory>
			<includes>
				<include>*.jar</include>
			</includes>
		</fileSet>
	</fileSets>
</assembly>