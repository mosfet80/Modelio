<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry excluding=".svn/" kind="src" path="src"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="lib" path="/compilation-env/javadesigner.jar"/>
	<classpathentry kind="lib" path="lib/org.hsqldb.hsqldb-2.7.1-debug.jar" sourcepath="lib_src/hsqldb-2.7.1-sources.jar"/>
	<classpathentry exported="true" kind="lib" path="res" sourcepath="res"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
