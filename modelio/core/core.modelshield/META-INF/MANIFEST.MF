Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Model Shield
Bundle-SymbolicName: org.modelio.core.modelshield;singleton:=true
Bundle-Version: 6.2.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: org.eclipse.osgi,
 org.modelio.core.kernel,
 org.modelio.core.session,
 org.modelio.core.utils
Export-Package: org.modelio.core.modelshield,
 org.modelio.core.modelshield.engine
Import-Package: jakarta.annotation;version="1.1.0",
 jakarta.inject;version="1.0.0"
Bundle-ClassPath: .
Bundle-ActivationPolicy: lazy
Bundle-Activator: org.modelio.core.modelshield.plugin.ModelShield
Bundle-Vendor: modelio.org
Bundle-Localization: plugin
